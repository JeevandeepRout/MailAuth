# ==============================================================================
# MailAuth Server Environment Configuration
# ==============================================================================

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Option A: MongoDB Atlas (Cloud Database - Free & Recommended)
# Example: MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/mailauth?retryWrites=true&w=majority
#
# Option B: Local MongoDB (Installed on your computer)
# Example: MONGODB_URI=mongodb://127.0.0.1:27017/mailauth
#
# Option C: Leave empty or default to use automatic In-Memory database for testing
MONGODB_URI=mongodb://127.0.0.1:27017/mailauth

# If set to true, the server will error out if your custom MONGODB_URI fails to connect (no in-memory fallback)
STRICT_DB=false

# ------------------------------------------------------------------------------
# JWT AUTHENTICATION SECRETS
# ------------------------------------------------------------------------------
JWT_SECRET=super_secret_mailauth_jwt_key_2026_production_ready
JWT_EXPIRES_IN=7d
OTP_EXPIRE_MINUTES=10

# ------------------------------------------------------------------------------
# EMAIL (SMTP) CONFIGURATION
# ------------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="MailAuth <noreply@mailauth.local>"
